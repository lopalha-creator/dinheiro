/*
 * Atalho da app Dinheiro (https://lopalha-creator.github.io/dinheiro/).
 * Dívida: quem → quantia → devem-me (+) ou devo eu (−) → descrição.
 * Gasto: de que conta → quantia → descrição.
 * Acrescenta a linha (com a data e a hora em que foi registada) a iCloud Drive/Atalhos/Dinheiro/atalho.txt
 * e copia o ficheiro todo. Na app, "Colar do atalho" junta os movimentos que ainda não tinha:
 *   2026-10-09T10:30:15;mais;Mãe;12,5;jantar
 */

#include 'actions/calendar'
#include 'actions/documents'
#include 'actions/text'
#include 'actions/sharing'

#define name Dinheiro
#define color blue
#define glyph euroSign

comment('Pessoas das dívidas, uma por linha, com os nomes como estão na app Dinheiro (Mais → Atalho do iPhone → Copiar).')
const textoPessoas = text("Pai\nMãe\nMafalda\nMiga\nCosta\nDuda\nMonti\nFranci\nGodinho\nLuigi\nCardoso\nMité")
const listaPessoas = splitText(textoPessoas, "\n")
comment('Contas dos gastos, uma por linha, com os nomes como estão na app.')
const textoContas = text("Revolut\nCarteira\nConta corrente")
const listaContas = splitText(textoContas, "\n")

@tipo = ""
@nome = ""
@quantia = ""
menu "Dinheiro" {
    item "Dívida":
        const quem = chooseFromList(listaPessoas, "Quem?")
        nothing()
        const quantiaDivida = prompt("Quantia", "Number")
        menu "Quem deve?" {
            item "Devem-me (+)":
                @tipo = "mais"
            item "Devo eu (−)":
                @tipo = "menos"
        }
        @nome = "{quem}"
        @quantia = "{quantiaDivida}"
    item "Gasto":
        const conta = chooseFromList(listaContas, "De onde?")
        nothing()
        const quantiaGasto = prompt("Quantia", "Number")
        @tipo = "gasto"
        @nome = "{conta}"
        @quantia = "{quantiaGasto}"
}

nothing()
const descricao = prompt("Descrição", "Text", "", "false")
const agora = currentDate()
const data = formatDate(agora, "Custom", "yyyy-MM-dd'T'HH:mm:ss")
const linha = text("{data};{@tipo};{@nome};{@quantia};{descricao}")
appendToFile("Dinheiro/atalho.txt", linha)
const ficheiro = getFile("Dinheiro/atalho.txt")
const todos = getText(ficheiro)
setClipboard(todos)
showNotification("Abre a app e toca em Colar do atalho.", "Guardado: {@nome} {@quantia} €")
