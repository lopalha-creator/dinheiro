/*
 * Atalho da app Dinheiro (https://lopalha-creator.github.io/dinheiro/).
 * Dívida: quem → quantia → devem-me (+) ou devo eu (−) → descrição.
 * Gasto: de que conta → quantia → descrição.
 * Acrescenta a linha (com a data e a hora em que foi registada) a iCloud Drive/Atalhos/Dinheiro/atalho.txt
 * e copia-o. Ao abrir, a app pergunta pelo ficheiro (ou cola o que foi copiado) e junta os que faltam:
 *   2026-10-09T10:30:15;mais;Mãe;12,5;jantar
 */

#include 'actions/calendar'
#include 'actions/documents'
#include 'actions/text'
#include 'actions/sharing'

#define name Dinheiro
#define color blue
#define glyph euroSign
// Só no iPhone (e na pesquisa): no Apple Watch não há iCloud Drive para escrever o atalho.txt.
#define from search

// Obter ficheiro pelo caminho, sem abrir o seletor (o getFile normal abre-o).
action 'documentpicker.open' lerFicheiro(text path: 'WFGetFilePath') {
    "WFShowFilePicker": false
}
// Acrescentar uma linha ao ficheiro. O texto tem de ir como texto: como variável solta, o iPhone escreve uma linha vazia.
action 'file.append' acrescentarLinha(text caminho: 'WFFilePath', text texto: 'WFInput') {
    "WFAppendFileWriteMode": "Append",
    "WFAppendOnNewLine": true
}
// Pedir texto numa só linha (o Enter confirma).
action 'ask' pedirLinha(text prompt: 'WFAskActionPrompt') {
    "WFInputType": "Text",
    "WFAllowsMultilineText": false
}

comment('Pessoas das dívidas, uma por linha, com os nomes como estão na app Dinheiro (Definições → Atalho do iPhone → Copiar lista de pessoas).')
const textoPessoas = text("Pai\nMãe\nMafalda\nMiga\nCosta\nDuda\nMonti\nFranci\nGodinho\nLuigi\nCardoso\nMité")
const listaPessoas = splitText(textoPessoas, "\n")
comment('Contas dos gastos, uma por linha, com os nomes como estão na app.')
const textoContas = text("Revolut\nCarteira\nConta corrente")
const listaContas = splitText(textoContas, "\n")

@tipo = ""
@nome = ""
@quantia = ""
menu "Dinheiro" {
    item "Dívida":
        const quem = chooseFromList(listaPessoas, "Quem?")
        nothing()
        const quantiaDivida = prompt("Quantia", "Number")
        menu "Quem deve?" {
            item "Devem-me (+)":
                @tipo = "mais"
            item "Devo eu (−)":
                @tipo = "menos"
        }
        @nome = "{quem}"
        @quantia = "{quantiaDivida}"
    item "Gasto":
        const conta = chooseFromList(listaContas, "De onde?")
        nothing()
        const quantiaGasto = prompt("Quantia", "Number")
        @tipo = "gasto"
        @nome = "{conta}"
        @quantia = "{quantiaGasto}"
}

nothing()
const descricao = pedirLinha("Descrição")
const agora = currentDate()
const data = formatDate(agora, "Custom", "yyyy-MM-dd'T'HH:mm:ss")
const linha = text("{data};{@tipo};{@nome};{@quantia};{descricao}")
acrescentarLinha("Dinheiro/atalho.txt", "{linha}")
const ficheiro = lerFicheiro("Dinheiro/atalho.txt")
const todos = getText(ficheiro)
setClipboard(todos)
showNotification("Abre a app e escolhe atalho.txt.", "Guardado: {@nome} {@quantia} €")
